<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_aqua_operator" model="res.groups">
        <field name="name">Aqua RAS / Operator</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_aqua_supervisor" model="res.groups">
        <field name="name">Aqua RAS / Supervisor</field>
        <field name="implied_ids" eval="[(4, ref('group_aqua_operator'))]"/>
    </record>
    <record id="group_aqua_manager" model="res.groups">
        <field name="name">Aqua RAS / Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_aqua_supervisor'))]"/>
    </record>
</odoo>
