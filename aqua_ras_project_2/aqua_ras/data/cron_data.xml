<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_aqua_offline" model="ir.cron">
        <field name="name">Aqua: cek sensor offline</field>
        <field name="model_id" ref="model_aqua_device"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_offline()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_aqua_escalate" model="ir.cron">
        <field name="name">Aqua: eskalasi alarm</field>
        <field name="model_id" ref="model_aqua_alert"/>
        <field name="state">code</field>
        <field name="code">model._cron_escalate()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_aqua_purge" model="ir.cron">
        <field name="name">Aqua: arsip data sensor lama</field>
        <field name="model_id" ref="model_aqua_reading_agg"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
